# ============================================================
# Copia este archivo a .env y rellena los valores reales.
# .env está en .gitignore — NUNCA pongas credenciales reales aquí en .env.example.
# ============================================================

# Conexión a PostgreSQL
# Ejemplo local:  postgresql://usuario:password@localhost:5432/marketplace
# Ejemplo Supabase/Neon/Railway: usa el connection string que te den
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# NextAuth
# Genera el secret con:  openssl rand -base64 32
NEXTAUTH_SECRET="reemplaza-con-un-secret-de-32-bytes-en-base64"
NEXTAUTH_URL="http://localhost:3000"

# Notificaciones por email (opcional). Sin esto, la app funciona igual
# pero no se envían los avisos de cambio de estado de cotización.
# Crea una cuenta gratuita en https://resend.com y verifica un dominio o usa
# su dominio de pruebas onboarding@resend.dev mientras desarrollas.
RESEND_API_KEY=""
EMAIL_FROM="notificaciones@tu-dominio.com"

# Almacenamiento de archivos adjuntos (opcional, pero necesario para poder
# adjuntar archivos a una cotización). En Vercel: Storage -> Create -> Blob,
# y esta variable se agrega sola al conectar el proyecto. En local, cópiala
# desde el dashboard de Vercel (Storage -> tu Blob store -> .env.local tab).
BLOB_READ_WRITE_TOKEN=""

# ============================================================
# Sondeo diario de cotizaciones (Fase 2 - tarea programada de Claude)
# ============================================================

# Token para que la tarea programada llame a /api/sondeo/* sin sesión de navegador.
# Genera uno con:  openssl rand -hex 32
# Da acceso SOLO a los endpoints de sondeo, no al resto de la app.
CRON_SECRET=""

# URL pública de la app, usada por la tarea programada para saber a dónde llamar.
# En local no aplica (la nube no alcanza localhost); en producción: https://tu-app.vercel.app
APP_URL="http://localhost:3000"

# ============================================================
# Mercadeo automatizado (constructora) — todo opcional
# Sin estas variables el módulo /mercadeo funciona con carga manual de
# métricas, copies por plantilla y enlace de aprobación para copiar.
# ============================================================

# Claude redacta la estrategia y los copies (si no, se usan plantillas).
ANTHROPIC_API_KEY=""
# MERCADEO_MODELO_CLAUDE="claude-opus-5-5"

# Correo(s) que reciben el plan semanal para aprobación (separados por coma).
# El envío usa RESEND_API_KEY / EMAIL_FROM de arriba. Cuenta de la empresa:
# si la cuenta de Resend se crea con este mismo correo, basta EMAIL_FROM="onboarding@resend.dev"
# (sin verificar dominio, Resend solo entrega al correo dueño de la cuenta).
MERCADEO_EMAIL_APROBACION="oasissas8@gmail.com"

# Meta (Facebook + Instagram). Token de usuario del sistema de Business Manager con
# permisos: pages_read_engagement, pages_manage_posts, instagram_basic,
# instagram_content_publish, instagram_manage_insights, ads_management, ads_read.
META_ACCESS_TOKEN=""
META_PAGE_ID=""
META_IG_USER_ID=""
META_AD_ACCOUNT_ID=""          # con o sin prefijo act_
# META_PAGE_ACCESS_TOKEN=""    # opcional; si no, se obtiene con META_ACCESS_TOKEN
# META_API_VERSION="v23.0"
# META_PAIS="CO"
# META_CATEGORIA_ESPECIAL="HOUSING"  # categoría especial de vivienda (radio mín. 25 km, sin edad/género)
# META_FACTOR_MONEDA="100"           # Meta recibe presupuestos en la unidad mínima de la moneda
# Por seguridad los anuncios se crean EN PAUSA al aprobar. true = quedan activos (empiezan a gastar).
META_ACTIVAR_AL_APROBAR="false"

# Límites de pauta
# MERCADEO_MIN_PRESUPUESTO_PAUTA="100000"   # presupuesto mínimo por pieza pautada
# MERCADEO_TOPE_PRESUPUESTO_SEMANAL="0"     # 0 = sin tope; si se supera, no se genera el plan
# MERCADEO_RADIO_KM="25"
# MERCADEO_ZONA_HORARIA="America/Bogota"

# Tarea automática semanal (POST /api/mercadeo/automatizar con Bearer). Distinto a CRON_SECRET.
MERCADEO_CRON_SECRET=""
MERCADEO_EMPRESA_ID=""         # id de la Empresa (constructora) sobre la que opera la tarea

# Colores de las piezas gráficas
# MERCADEO_COLOR_PRIMARIO="#1e40af"
# MERCADEO_COLOR_OSCURO="#0f172a"
# MERCADEO_COLOR_ACENTO="#f59e0b"
