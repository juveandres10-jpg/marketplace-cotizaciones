// ============================================================
// Esquema de base de datos - Marketplace de Cotizaciones
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// Usuarios y empresas
// ------------------------------------------------------------

enum RolUsuario {
  COMPRADOR
  PROVEEDOR
  ADMIN
}

// Nivel de permiso dentro de la propia empresa (no confundir con RolUsuario,
// que distingue comprador/proveedor). ADMIN_EMPRESA puede crear proyectos,
// publicar productos y aprobar/descartar cotizaciones; MIEMBRO solo puede
// ver y proponer (enviar solicitudes, responder precios) pero no aprobar.
enum RolEmpresa {
  ADMIN_EMPRESA
  MIEMBRO
}

model Usuario {
  id           String     @id @default(cuid())
  nombre       String
  email        String     @unique
  passwordHash String
  rol          RolUsuario
  rolEmpresa   RolEmpresa @default(ADMIN_EMPRESA)
  empresaId    String?
  empresa      Empresa?   @relation(fields: [empresaId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  proyectosCreados     Proyecto[]          @relation("ProyectosCreadosPor")
  cotizacionesEnviadas Cotizacion[]        @relation("CotizacionesEnviadasPor")
  archivosSubidos      ArchivoCotizacion[] @relation("ArchivosSubidosPor")
  sondeosCapturados    CotizacionMercado[] @relation("SondeosCapturadosPor")
  planesMercadeo       PlanSemanal[]       @relation("PlanesCreadosPor")
}

enum TipoEmpresa {
  COMPRADOR
  PROVEEDOR
  AMBOS
}

model Empresa {
  id        String      @id @default(cuid())
  nombre    String
  nit       String?     @unique
  tipo      TipoEmpresa
  pais      String?
  sitioWeb  String?
  telefono  String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  usuarios     Usuario[]
  productos    Producto[]   @relation("ProductosDeProveedor")
  proyectos    Proyecto[]   @relation("ProyectosDeEmpresa")
  cotizaciones Cotizacion[] @relation("CotizacionesDeProveedor")

  proyectosVenta      ProyectoVenta[]
  metricasPublicacion MetricaPublicacion[]
  snapshotsCuenta     SnapshotCuenta[]
  planesMercadeo      PlanSemanal[]
}

// ------------------------------------------------------------
// Catálogo de productos (compartido entre proyectos)
// ------------------------------------------------------------

model CategoriaProducto {
  id        String     @id @default(cuid())
  nombre    String     @unique
  productos Producto[]
}

model Producto {
  id          String             @id @default(cuid())
  nombre      String
  descripcion String?
  marca       String?
  modelo      String?
  unidad      String             @default("unidad") // unidad, kWp, m2, ton, etc.
  precioRef   Float? // último precio de referencia conocido
  moneda      String             @default("USD")
  categoriaId String?
  categoria   CategoriaProducto? @relation(fields: [categoriaId], references: [id])
  proveedorId String
  proveedor   Empresa            @relation("ProductosDeProveedor", fields: [proveedorId], references: [id])
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  // Sondeo diario de mercado (búsqueda de proveedores en Alibaba, etc.)
  seguimientoActivo Boolean @default(true) // entra en la revisión diaria
  minCotizaciones   Int     @default(5) // objetivo mínimo de cotizaciones por revisión

  // Flete + seguro estimado por unidad para llegar a destino (ej. CIF Cartagena).
  // Lo ingresa el usuario (su tarifa real con naviera/agente aduanal) — el sistema
  // NUNCA inventa este número. Se usa solo para calcular un CIF estimado sobre
  // las cotizaciones que estén en la misma moneda que `moneda` de este producto.
  fleteEstimadoUnit    Float?
  fleteEstimadoDestino String? // ej. "CIF Puerto de Cartagena, Colombia"
  fleteEstimadoNotas   String? // ej. "Cotizado con Agencia XYZ, contenedor 40ft, sep 2026"

  itemsCotizacion     ItemCotizacion[]
  itemsProyecto       ItemProyecto[]
  cotizacionesMercado CotizacionMercado[]
}

// ------------------------------------------------------------
// Proyectos
// ------------------------------------------------------------

enum EstadoProyecto {
  PREFACTIBILIDAD
  DISENO
  COTIZACION
  APROBADO
  EN_EJECUCION
  FINALIZADO
  CANCELADO
}

model Proyecto {
  id          String         @id @default(cuid())
  nombre      String
  descripcion String?
  estado      EstadoProyecto @default(PREFACTIBILIDAD)
  empresaId   String
  empresa     Empresa        @relation("ProyectosDeEmpresa", fields: [empresaId], references: [id])
  creadoPorId String
  creadoPor   Usuario        @relation("ProyectosCreadosPor", fields: [creadoPorId], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  items               ItemProyecto[]
  cotizaciones        Cotizacion[]
  cotizacionesMercado CotizacionMercado[]
}

// Lista de materiales (BOM) del proyecto: qué productos necesita y en qué cantidad
model ItemProyecto {
  id          String    @id @default(cuid())
  proyectoId  String
  proyecto    Proyecto  @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  productoId  String?
  producto    Producto? @relation(fields: [productoId], references: [id])
  nombreLibre String? // por si el producto aún no existe en catálogo
  cantidad    Float
  unidad      String    @default("unidad")
  notas       String?
}

// ------------------------------------------------------------
// Cotizaciones (RFQ - Request for Quotation)
// ------------------------------------------------------------

enum EstadoCotizacion {
  BORRADOR
  ENVIADA
  EN_NEGOCIACION
  RECIBIDA
  APROBADA
  DESCARTADA
}

model Cotizacion {
  id           String           @id @default(cuid())
  proyectoId   String
  proyecto     Proyecto         @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  proveedorId  String
  proveedor    Empresa          @relation("CotizacionesDeProveedor", fields: [proveedorId], references: [id])
  enviadaPorId String
  enviadaPor   Usuario          @relation("CotizacionesEnviadasPor", fields: [enviadaPorId], references: [id])
  estado       EstadoCotizacion @default(BORRADOR)
  moneda       String           @default("USD")
  validaHasta  DateTime?
  notas        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  items    ItemCotizacion[]
  archivos ArchivoCotizacion[]
}

model ItemCotizacion {
  id           String     @id @default(cuid())
  cotizacionId String
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  productoId   String?
  producto     Producto?  @relation(fields: [productoId], references: [id])
  descripcion  String // descripción libre si no hay producto de catálogo
  cantidad     Float
  precioUnit   Float?
  subtotal     Float?
}

// ------------------------------------------------------------
// Archivos adjuntos (fichas técnicas, PDFs de cotización, etc.)
// ------------------------------------------------------------

model ArchivoCotizacion {
  id           String     @id @default(cuid())
  cotizacionId String
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  nombre       String
  url          String
  tipo         String? // MIME type
  tamanoBytes  Int?
  subidoPorId  String
  subidoPor    Usuario    @relation("ArchivosSubidosPor", fields: [subidoPorId], references: [id])
  createdAt    DateTime   @default(now())
}

// ------------------------------------------------------------
// Sondeo diario de mercado
// Búsqueda periódica de proveedores/precios (Alibaba, etc.) para cada
// producto en seguimiento. Es un flujo aparte de Cotizacion (RFQ formal
// entre empresas registradas): aquí los proveedores son leads externos.
// ------------------------------------------------------------

enum FuenteCotizacion {
  ALIBABA
  MANUAL
  OTRO
}

enum EstadoRevision {
  EN_PROGRESO
  COMPLETADA
  PARCIAL // se completó pero faltaron productos (p. ej. captcha en Alibaba)
  FALLIDA
}

// Una corrida del proceso de revisión diaria.
model RevisionDiaria {
  id                 String         @id @default(cuid())
  fecha              DateTime       @default(now())
  estado             EstadoRevision @default(EN_PROGRESO)
  minPorProducto     Int            @default(5) // objetivo de cotizaciones por producto
  productosObjetivo  Int            @default(0) // cuántos productos había que revisar
  productosRevisados Int            @default(0)
  cotizacionesNuevas Int            @default(0)
  resumen            String? // resumen en markdown de la corrida
  detalle            Json? // resultado estructurado por producto
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  cotizaciones CotizacionMercado[]
}

// Un precio/proveedor hallado para un producto en una fecha dada.
model CotizacionMercado {
  id         String          @id @default(cuid())
  productoId String
  producto   Producto        @relation(fields: [productoId], references: [id], onDelete: Cascade)
  proyectoId String?
  proyecto   Proyecto?       @relation(fields: [proyectoId], references: [id], onDelete: SetNull)
  revisionId String?
  revision   RevisionDiaria? @relation(fields: [revisionId], references: [id], onDelete: SetNull)

  fuente            FuenteCotizacion @default(ALIBABA)
  proveedorNombre   String
  proveedorPais     String?
  proveedorUrl      String? // enlace a la ficha del proveedor/producto
  precioUnit        Float?
  moneda            String           @default("USD")
  unidad            String           @default("unidad")
  moq               Float? // cantidad mínima de pedido
  incoterm          String? // FOB, CIF, EXW, ...
  tiempoEntregaDias Int?
  notas             String?

  fechaRevision  DateTime @default(now())
  capturadoPorId String? // null si lo capturó la tarea programada
  capturadoPor   Usuario? @relation("SondeosCapturadosPor", fields: [capturadoPorId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([productoId, fechaRevision])
  @@index([revisionId])
}

// ------------------------------------------------------------
// Mercadeo automatizado (constructora)
// Análisis de métricas de Facebook/Instagram -> plan semanal de
// publicaciones y pauta -> aprobación por correo -> publicación/pauta
// en Meta. Nada se pauta (no se gasta dinero) sin una aprobación.
// ------------------------------------------------------------

enum PlataformaSocial {
  FACEBOOK
  INSTAGRAM
}

enum FormatoPieza {
  IMAGEN
  CARRUSEL
  VIDEO
  REEL
  HISTORIA
}

enum ObjetivoPauta {
  LEADS // tráfico a landing / formulario para captar datos
  MENSAJES // conversaciones por WhatsApp / Messenger
  TRAFICO
  ALCANCE
}

enum FuenteMetrica {
  META_API
  MANUAL
}

enum EstadoPlan {
  BORRADOR
  PENDIENTE_APROBACION
  APROBADO
  RECHAZADO
  PUBLICADO // aprobado y enviado a Meta
}

// Proyecto inmobiliario que se está vendiendo/promocionando.
// Es la "información que tenemos" para generar piezas y copies:
// la app nunca inventa precios ni características que no estén aquí.
model ProyectoVenta {
  id                 String   @id @default(cuid())
  empresaId          String
  empresa            Empresa  @relation(fields: [empresaId], references: [id])
  nombre             String
  tipoInmueble       String   @default("Apartamentos") // Apartamentos, Casas, Lotes, VIS, Oficinas...
  ciudad             String
  zona               String? // barrio / sector
  direccion          String?
  latitud            Float? // para segmentar la pauta por radio alrededor del proyecto
  longitud           Float?
  precioDesde        Float?
  moneda             String   @default("COP")
  areaDesde          Float? // m2
  habitaciones       String? // ej. "2 y 3 alcobas"
  amenidades         String? // ej. "Piscina, gimnasio, BBQ, parque infantil"
  diferenciales      String? // ej. "Aplica subsidio Mi Casa Ya, entrega 2027"
  publicoObjetivo    String? // ej. "Familias jóvenes, primera vivienda"
  urlLanding         String?
  whatsapp           String? // número en formato internacional, ej. 573001234567
  imagenUrl          String? // render/foto pública que se usa de fondo en las piezas
  presupuestoSemanal Float? // presupuesto de pauta sugerido por semana
  activo             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  planes   PlanSemanal[]
  metricas MetricaPublicacion[]
}

// Métricas de una publicación (orgánica o pauta) en una red social.
model MetricaPublicacion {
  id               String           @id @default(cuid())
  empresaId        String
  empresa          Empresa          @relation(fields: [empresaId], references: [id])
  proyectoVentaId  String?
  proyectoVenta    ProyectoVenta?   @relation(fields: [proyectoVentaId], references: [id], onDelete: SetNull)
  plataforma       PlataformaSocial
  fuente           FuenteMetrica    @default(MANUAL)
  externoId        String? // id de Meta (post, media o `ad:<id>`); null en carga manual
  fechaPublicacion DateTime
  horaConocida     Boolean          @default(true) // false en pauta (Meta solo reporta el día)
  formato          FormatoPieza     @default(IMAGEN)
  pagada           Boolean          @default(false)
  texto            String?
  alcance          Int              @default(0)
  impresiones      Int              @default(0)
  interacciones    Int              @default(0) // reacciones + comentarios + compartidos + guardados
  clics            Int              @default(0)
  leads            Int              @default(0)
  mensajes         Int              @default(0)
  gasto            Float            @default(0)
  moneda           String           @default("COP")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([empresaId, plataforma, externoId])
  @@index([empresaId, fechaPublicacion])
}

// Foto del estado de la cuenta en una fecha (seguidores).
model SnapshotCuenta {
  id         String           @id @default(cuid())
  empresaId  String
  empresa    Empresa          @relation(fields: [empresaId], references: [id])
  plataforma PlataformaSocial
  fecha      DateTime         @default(now())
  seguidores Int
  fuente     FuenteMetrica    @default(MANUAL)

  @@index([empresaId, plataforma, fecha])
}

// Plan semanal de mercadeo: análisis + estrategia + piezas, sujeto a aprobación.
model PlanSemanal {
  id               String        @id @default(cuid())
  empresaId        String
  empresa          Empresa       @relation(fields: [empresaId], references: [id])
  proyectoVentaId  String
  proyectoVenta    ProyectoVenta @relation(fields: [proyectoVentaId], references: [id], onDelete: Cascade)
  semanaInicio     DateTime // lunes 00:00 (zona horaria de la empresa)
  estado           EstadoPlan    @default(BORRADOR)
  presupuestoTotal Float         @default(0)
  moneda           String        @default("COP")
  analisis         Json // resultado de analizarMetricas()
  estrategia       String // markdown
  generadoCon      String        @default("plantilla") // "claude" | "plantilla"
  creadoPorId      String?
  creadoPor        Usuario?      @relation("PlanesCreadosPor", fields: [creadoPorId], references: [id], onDelete: SetNull)

  // Aprobación por correo (se guarda solo el hash del token)
  tokenAprobacionHash String?   @unique
  tokenExpira         DateTime?
  enviadoA            String?
  enviadoEn           DateTime?
  decididoPor         String?
  decididoEn          DateTime?
  comentarioDecision  String?

  // Resultado de la publicación en Meta (ids creados, errores)
  metaCampaignId String?
  metaResultado  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  piezas PiezaPlan[]

  @@index([empresaId, semanaInicio])
}

// Una publicación/pauta dentro del plan.
model PiezaPlan {
  id              String           @id @default(cuid())
  planId          String
  plan            PlanSemanal      @relation(fields: [planId], references: [id], onDelete: Cascade)
  orden           Int
  fechaProgramada DateTime
  plataforma      PlataformaSocial
  formato         FormatoPieza
  objetivo        ObjetivoPauta    @default(LEADS)
  tema            String
  pagada          Boolean          @default(false)
  presupuesto     Float            @default(0)
  diasPauta       Int              @default(0)
  titular         String
  copy            String
  cta             String
  hashtags        String?
  conceptoVisual  String // descripción de la imagen/escena (sirve de prompt para diseño)
  guionVideo      String? // guion por escenas para VIDEO/REEL/HISTORIA

  // Publicación en Meta
  estadoMeta  String? // PENDIENTE | PROGRAMADA | PUBLICADA | PAUTA_CREADA | ERROR
  metaPostId  String?
  metaAdSetId String?
  metaAdId    String?
  errorMeta   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId, orden])
}
