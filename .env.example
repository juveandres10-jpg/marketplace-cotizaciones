# ============================================================
# Copia este archivo a .env y rellena los valores reales.
# .env está en .gitignore — NUNCA pongas credenciales reales aquí en .env.example.
# ============================================================

# Conexión a PostgreSQL
# Ejemplo local:  postgresql://usuario:password@localhost:5432/marketplace
# Ejemplo Supabase/Neon/Railway: usa el connection string que te den
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# NextAuth
# Genera el secret con:  openssl rand -base64 32
NEXTAUTH_SECRET="reemplaza-con-un-secret-de-32-bytes-en-base64"
NEXTAUTH_URL="http://localhost:3000"

# Notificaciones por email (opcional). Sin esto, la app funciona igual
# pero no se envían los avisos de cambio de estado de cotización.
# Crea una cuenta gratuita en https://resend.com y verifica un dominio o usa
# su dominio de pruebas onboarding@resend.dev mientras desarrollas.
RESEND_API_KEY=""
EMAIL_FROM="notificaciones@tu-dominio.com"

# Almacenamiento de archivos adjuntos (opcional, pero necesario para poder
# adjuntar archivos a una cotización). En Vercel: Storage -> Create -> Blob,
# y esta variable se agrega sola al conectar el proyecto. En local, cópiala
# desde el dashboard de Vercel (Storage -> tu Blob store -> .env.local tab).
BLOB_READ_WRITE_TOKEN=""

# ============================================================
# Sondeo diario de cotizaciones (Fase 2 - tarea programada de Claude)
# ============================================================

# Token para que la tarea programada llame a /api/sondeo/* sin sesión de navegador.
# Genera uno con:  openssl rand -hex 32
# Da acceso SOLO a los endpoints de sondeo, no al resto de la app.
CRON_SECRET=""

# URL pública de la app, usada por la tarea programada para saber a dónde llamar.
# En local no aplica (la nube no alcanza localhost); en producción: https://tu-app.vercel.app
APP_URL="http://localhost:3000"
